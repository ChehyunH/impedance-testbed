<mujoco model="pendulum">
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <worldbody>
    <body name="link" pos="0 0 0.5">
      <joint name="jointa" type="hinge" axis="0 1 0" damping="0"/>
      <geom type="capsule" fromto="0 0 0   0 0 -0.15" size="0.005" mass="0.05"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="tau" joint="jointa" gear="1" ctrlrange="-0.03 0.03"/>
  </actuator>
</mujoco>
